# Shared local defaults (copy to .env)
DATABASE_URL=postgresql://aiconn:aiconn@localhost:5432/aiconnector?schema=public
DATABASE_URL_TEST=postgresql://aiconn:aiconn@localhost:5432/aiconnector_test?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-change-me-use-long-random-string
# Optional; falls back to JWT_SECRET for local/CI
# MFA_ENCRYPTION_KEY=dev-mfa-encryption-key-change-me
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# S3 assistant — mock if OPENAI_API_KEY unset or AI_PROVIDER=mock
AI_ENABLED=1
AI_PROVIDER=mock
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
