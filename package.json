{
  "name": "ai-connector",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --parallel -r run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @ai-connector/api test",
    "test:unit": "pnpm --filter @ai-connector/api test:unit",
    "db:generate": "pnpm --filter @ai-connector/api prisma:generate",
    "db:migrate": "pnpm --filter @ai-connector/api prisma:migrate",
    "db:seed": "pnpm --filter @ai-connector/api prisma:seed",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}
