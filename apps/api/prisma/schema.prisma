generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  Membership[]
  roleBindings RoleBinding[]
  sessions     Session[]
  auditEvents  AuditEvent[]   @relation("AuditActor")
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  timezone  String     @default("America/Puerto_Rico")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  companies Company[]
  memberships Membership[]
  roles     Role[]
  roleBindings RoleBinding[]
  sessions  Session[]
  auditEvents AuditEvent[]
  connections Connection[]
  dataSnapshots DataSnapshot[]
  syncRuns  SyncRun[]
  dashboards Dashboard[]
  semanticModels SemanticModel[]
  metricDefinitions MetricDefinition[]
  goals Goal[]
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  timezone       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  roleBindings   RoleBinding[]
  sessions       Session[]
  connections    Connection[]
  dashboards     Dashboard[]
  goals          Goal[]

  @@index([organizationId])
  @@unique([organizationId, name])
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  userId         String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, companyId])
  @@index([userId])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  bindings       RoleBinding[]

  @@unique([organizationId, key])
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
  roles     RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleBinding {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  userId         String
  roleId         String
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  tokenHash            String   @unique
  activeOrganizationId String?
  activeCompanyId      String?
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  activeCompany        Company? @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

/// Mock (and later real) connector instance scoped to an organization.
model Connection {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  name           String
  provider       String   @default("mock")
  status         String   @default("active")
  config         Json     @default("{}")
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshots      DataSnapshot[]
  syncRuns       SyncRun[]
  dashboards     Dashboard[]
  semanticModels SemanticModel[]

  @@index([organizationId])
  @@index([organizationId, companyId])
}

/// Versioned analytical snapshot produced by a sync run.
model DataSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String
  version        Int
  rowCount       Int
  payload        Json
  etag           String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection     Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, version])
  @@index([organizationId, connectionId])
}

model SyncRun {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String
  trigger        String
  status         String   @default("queued")
  idempotencyKey String?
  errorMessage   String?
  snapshotId     String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection     Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([connectionId, createdAt])
  @@index([organizationId, createdAt])
}

/// Persistent dashboard bound to one connection (S1: freshness panel).
model Dashboard {
  id              String   @id @default(cuid())
  organizationId  String
  companyId       String?
  connectionId    String
  name            String
  staleAfterHours Int      @default(26)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection      Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  goals           Goal[]

  @@index([organizationId])
  @@index([connectionId])
}

/// Semantic layer over a connection's snapshots (S2 BI foundation).
model SemanticModel {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String
  name           String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection     Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  metrics        MetricDefinition[]

  @@unique([connectionId])
  @@index([organizationId])
}

model MetricDefinition {
  id              String   @id @default(cuid())
  organizationId  String
  semanticModelId String
  key             String
  label           String
  description     String?
  /// Path into snapshot payload, e.g. metrics.ventas_dia or rows.*.unidades
  sourcePath      String
  aggregation     String   @default("latest")
  unit            String?
  format          String   @default("number")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  semanticModel   SemanticModel @relation(fields: [semanticModelId], references: [id], onDelete: Cascade)

  @@unique([semanticModelId, key])
  @@index([organizationId])
}

/// Target for a metric key, evaluated against latest snapshot KPIs.
model Goal {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  dashboardId    String?
  metricKey      String
  name           String
  targetValue    Float
  /// gte = actual >= target is success; lte = actual <= target is success
  comparator     String   @default("gte")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dashboard      Dashboard?   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dashboardId])
  @@index([metricKey])
}
